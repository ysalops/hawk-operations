# Banco PostgreSQL
POSTGRES_DB=ylume_ops
POSTGRES_USER=ylume_ops
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Acesso ao Ylume Ops
YLUME_OPS_ACCESS_PASSWORD=troque-por-uma-senha-de-acesso
YLUME_OPS_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# Local: false | Produção HTTPS: o docker-compose.prod.yml força true
YLUME_OPS_COOKIE_SECURE=false

# IA opcional para leitura de imagem/print
# Não é necessária para texto, CSV ou Excel.
OPENAI_API_KEY=
YLUME_OPS_AI_MODEL=gpt-5.6-luna
